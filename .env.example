# Copy to .env in this directory and fill in real values.
# Never commit the actual .env file.

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-random-secret
ALLOWED_HOSTS=*

# Matches the `db` service in docker-compose.yml
DATABASE_URL=postgres://innovation_hub:innovation_hub@db:5432/innovation_hub

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Celery/Redis and S3 vars removed for now — see docker-compose.celery-example.yml
# and config/settings/base.py for how to bring them back when needed.

# Local payment rails (Doc 08 Sec 3.2) — sandbox/test credentials only in dev
TELEBIRR_API_KEY=
CBE_BIRR_API_KEY=
CHAPA_SECRET_KEY=
