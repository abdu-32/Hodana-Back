# Copy to .env in this directory and fill in real values.
# Never commit the actual .env file.

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-random-secret
ALLOWED_HOSTS=*

# Matches the `db` service in docker-compose.yml
DATABASE_URL=postgres://innovation_hub:innovation_hub@db:5432/innovation_hub

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Matches the `redis` service in docker-compose.yml
REDIS_URL=redis://redis:6379/0

# S3 vars removed for now — see config/settings/base.py for how to bring them back when needed.

# Local payment rails (Doc 08 Sec 3.2) — sandbox/test credentials only in dev
TELEBIRR_API_KEY=
CBE_BIRR_API_KEY=
CHAPA_SECRET_KEY=

# FR-AUTH-005 — OAuth sign-in. Leave blank to disable a given provider
# (attempting to use it returns a clear "not configured" error rather
# than a confusing failure deep in the token exchange).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production only (config/settings/production.py) — shared cache backend
# for IP-based throttle counters (login/signup/oauth_login/
# password_reset_request). Defaults to REDIS_URL's host on db 1, so it's
# usually fine to leave unset; override only if you want the throttle
# cache on a separate Redis instance/db from the Celery broker.
CACHE_URL=

RECOGNIZED_INSTITUTIONAL_DOMAINS=aau.edu.et,aastu.edu.et